  <!-- ==================== BUSINESS RULES ==================== -->
  <sys_script action="INSERT_OR_UPDATE" sys_id="f92ca31d472dc3509127d44a516d43bd">
    <name>Network Request - Set Initial State</name>
    <collection>u_network_request</collection>
    <when>before</when>
    <active>true</active>
    <condition></condition>
    <script><![CDATA[(function executeRule(current, previous) { current.u_approval_state = "pending"; current.u_requested_for = gs.getUserID(); current.u_requested_for_email = gs.getUser().getEmail(); current.u_requested_for_username = gs.getUser().getUserName(); current.u_requested_for_phone = gs.getUser().getPhone(); })(current);]]></script>
  </sys_script>

  <sys_script action="INSERT_OR_UPDATE" sys_id="dd2ca31d472dc3509127d44a516d4355">
    <name>Network Request - Auto Populate Requested For</name>
    <collection>u_network_request</collection>
    <when>before</when>
    <active>true</active>
    <condition></condition>
    <script><![CDATA[(function executeRule(current, previous) { if (!current.u_requested_for) { var u = gs.getUser(); current.u_requested_for = u.getID(); current.u_requested_for_email = u.getEmail(); current.u_requested_for_username = u.getUserName(); current.u_requested_for_phone = u.getPhone(); } })(current);]]></script>
  </sys_script>

  <sys_script action="INSERT_OR_UPDATE" sys_id="9a2ce31d472dc3509127d44a516d4321">
    <name>Network Request - Create Fulfillment Task</name>
    <collection>u_network_request</collection>
    <when>after</when>
    <active>true</active>
    <condition>u_approval_state=approved</condition>
    <script><![CDATA[(function executeRule(current, previous) {
    if (current.u_approval_state == 'approved' && previous.u_approval_state != 'approved') {
        var task = new GlideRecord('u_network_task');
        task.initialize();
        task.u_network_request = current.sys_id;
        task.u_task_type = 'Network Fulfillment';
        task.short_description = 'Fulfill: ' + current.u_request_type;
        task.description = current.u_description;
        task.assignment_group = current.u_network_group;
        task.priority = current.u_urgency;
        task.insert();
    }
})(current);]]></script>
  </sys_script>

  <sys_script action="INSERT_OR_UPDATE" sys_id="6a2ce31d472dc3509127d44a516d4353">
    <name>Network Task - Complete Request</name>
    <collection>u_network_task</collection>
    <when>after</when>
    <active>true</active>
    <condition>state=3</condition>
    <script><![CDATA[(function executeRule(current, previous) {
    if (current.state == '3' && previous.state != '3') {
        var req = new GlideRecord('u_network_request');
        if (req.get(current.u_network_request)) {
            var total = 0, closed = 0;
            var gr = new GlideRecord('u_network_task');
            gr.addQuery('u_network_request', current.u_network_request);
            gr.query();
            while (gr.next()) { total++; if (gr.state == '3') closed++; }
            if (total > 0 && total == closed) { req.u_approval_state = 'completed'; req.update(); }
        }
    }
})(current);]]></script>
  </sys_script>

  <!-- ==================== CLIENT SCRIPTS ==================== -->
  <sys_script_client action="INSERT_OR_UPDATE" sys_id="c065d26147a147509127d44a516d43ef">
    <name>Auto-populate User Details</name>
    <cat_item>78cb2f99472dc3509127d44a516d4394</cat_item>
    <type>onChange</type>
    <variable_name>u_opened_by</variable_name>
    <active>true</active>
    <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue === '') {
        g_form.setValue('u_email', '');
        g_form.setValue('u_username', '');
        g_form.setValue('u_phone', '');
        return;
    }
    g_form.getReference('u_opened_by', function(user) {
        g_form.setValue('u_email', user.email);
        g_form.setValue('u_username', user.user_name);
        g_form.setValue('u_phone', user.phone);
    });
}]]></script>
  </sys_script_client>

